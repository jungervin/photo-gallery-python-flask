+function rootPath(): string {
+    const value = typeof OC.getRootPath === 'function'
+        ? OC.getRootPath()
+        : (OC.webroot ?? '');
+    return value.replace(/\/$/, '');
+}
+
+function encodeFilePath(path: string): string {
+    return path
+        .replaceAll('\\', '/')
+        .split('/')
+        .filter(Boolean)
+        .map((segment) => encodeURIComponent(segment))
+        .join('/');
+}
+
+function davFileUrl(userId: string, path: string): string {
+    return `${rootPath()}/remote.php/dav/files/${encodeURIComponent(userId)}/${encodeFilePath(path)}`;
+}
+
+function davHeaders(extra: HeadersInit = {}): Headers {
+    const headers = new Headers(extra);
+    headers.set('Accept', 'application/xml, text/xml, */*');
+    if (OC.requestToken) headers.set('requesttoken', OC.requestToken);
+    return headers;
+}
